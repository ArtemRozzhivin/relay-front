{
	"name": "nextjs-fsd-template",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"dev:https": "next dev --turbopack --experimental-https",
		"build": "next build",
		"analyze": "ANALYZE=true next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:fsd": "steiger ./src",
		"format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}\"",
		"format:all": "prettier --write .",
		"format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}\"",
		"format:staged": "lint-staged",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"cypress:open": "cypress open",
		"cypress:run": "cypress run",
		"clean": "rm -rf .next out node_modules/.cache",
		"clean:all": "rm -rf .next out node_modules",
		"reinstall": "npm run clean:all && npm install",
		"plop": "plop",
		"g": "plop",
		"prepare": "husky",
		"prepare-hooks": "bash setup-hooks.sh"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@reduxjs/toolkit": "^2.5.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tailwindcss/postcss": "^4.1.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.8.0",
		"next": "16.3.0",
		"next-themes": "^0.4.6",
		"nuqs": "^2.8.9",
		"radix-ui": "^1.4.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-hook-form": "^7.72.1",
		"react-redux": "^9.2.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/json": "^2.1.1",
		"@feature-sliced/steiger-plugin": "^0.8.0",
		"@next/bundle-analyzer": "16.4.3",
		"@next/eslint-plugin-next": "16.4.3",
		"@svgr/webpack": "^8.1.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.5",
		"@types/qs": "^6.9.18",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.5",
		"@vitest/ui": "^5.0.5",
		"cypress": "^16.2.0",
		"eslint": "^10",
		"eslint-config-next": "16.4.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-boundaries": "^7.2.1",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.0",
		"msw": "^3.0.3",
		"plop": "^4.0.5",
		"postcss": "^8.5.31",
		"prettier": "^3.9.10",
		"shadcn": "^4.22.1",
		"steiger": "^0.8.0",
		"tailwindcss": "^4.1.11",
		"ts-node": "^10.9.2",
		"typescript": "^7",
		"typescript-eslint": "^8.46.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.0.5"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": [
			"prettier --write",
			"eslint --fix"
		]
	}
}
