#!/bin/sh

echo "▶️ Running pre-push checks..."

echo "🎨 Checking formatting..."
npm run format:check
if [ $? -ne 0 ]; then
  echo "❌ Formatting check failed. Run 'npm run format' to fix."
  exit 1
fi

echo "🔍 Running ESLint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint check failed."
  exit 1
fi

echo "📐 Checking FSD boundaries (Steiger)..."
npm run lint:fsd
if [ $? -ne 0 ]; then
  echo "❌ Steiger FSD check failed."
  exit 1
fi

echo "🔷 Checking TypeScript..."
npm run type-check
if [ $? -ne 0 ]; then
  echo "❌ TypeScript check failed."
  exit 1
fi

echo "🧪 Running tests..."
npm run test
if [ $? -ne 0 ]; then
  echo "❌ Tests failed."
  exit 1
fi

echo "🏗️ Running build..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed."
  exit 1
fi

echo "✅ Pre-push checks passed!"
